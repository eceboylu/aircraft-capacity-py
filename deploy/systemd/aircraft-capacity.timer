# aircraft-capacity.timer
#
# ##########################################################################
# LEGACY / DEPRECATED - DO NOT INSTALL ON A CURRENT PRODUCTION SERVER.
#
# Triggers the legacy aircraft-capacity.service (see that file's own
# header for full detail). Superseded by airport-queue-worker.service,
# which manages its own 5-minute refresh cadence internally and needs
# no systemd timer at all - see deploy/systemd/README.md.
#
# NEVER enable this unit (or aircraft-capacity.service) on any server
# that also runs airport-queue-worker.service - double-refresh risk,
# same DATABASE_URL written independently and uncoordinated by both.
# Kept for reference/history only, not deleted.
# ##########################################################################
#
# ADIM 5B - aircraft-capacity.service'i saatin :00 ve :30'unda tetikler
# (AirLabs verisinin kendisi de ~30 dakikada bir yenilendiği için bu
# kadence ile hizalı - sürekli polling/worker YOK, sadece batch refresh).

[Unit]
Description=Run aircraft-capacity pipeline every 30 minutes

[Timer]
# Saatin 0. ve 30. dakikasında çalışır (00:00, 00:30, 01:00, ...).
OnCalendar=*:0/30

# Sunucu bu zamanlardan birinde KAPALIYSA (bakım, reboot vb.), timer
# tekrar başladığında KAÇIRILAN çalıştırmayı bir kere telafi eder -
# uzun bir kesintiden sonra veri sessizce eskimiş kalmaz.
Persistent=true

# Ne kadar tetiklenirse tetiklensin, HER ZAMAN aynı service unit'i
# çalıştırır - systemd'nin "aynı unit birden fazla eşzamanlı job
# almaz" garantisi burada devreye girip overlap'i engeller (bkz.
# aircraft-capacity.service'teki not).
Unit=aircraft-capacity.service

[Install]
WantedBy=timers.target
