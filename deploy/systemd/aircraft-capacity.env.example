# aircraft-capacity.env.example
#
# ÖRNEK biçim - GERÇEK secret DEĞERLERİ içermez. Sunucuda bu dosyayı
# kopyalayıp gerçek değerlerle doldurun ve repo'nun DIŞINDA, kısıtlı
# izinli bir konuma koyun (aircraft-capacity.service içindeki
# `EnvironmentFile=` bu yolu gösterir):
#
#   sudo mkdir -p /etc/aircraft-capacity
#   sudo cp deploy/systemd/aircraft-capacity.env.example /etc/aircraft-capacity/aircraft-capacity.env
#   sudo chmod 600 /etc/aircraft-capacity/aircraft-capacity.env
#   sudo chown aircraft-capacity:aircraft-capacity /etc/aircraft-capacity/aircraft-capacity.env
#   # sonra dosyayı GERÇEK değerlerle düzenleyin.
#
# Bu dosya (ve /etc/aircraft-capacity/ altındaki gerçek kopyası) ASLA
# git'e eklenmemelidir - bkz. .gitignore (*.env).

# Bilgilendirici - app/db.py tarafından okunur ama artık DB engine
# seçimini ETKİLEMEZ (bkz. ADIM: MySQL-Only Database Layer, app/db.py
# docstring'i). DATABASE_URL HER environment'ta (local/dev/test/
# production, worker/web/script fark etmez) KOŞULSUZ ZORUNLUDUR - SQLite
# fallback'i (production'da da, dev'de de) TAMAMEN KALDIRILDI.
APP_ENV=production

# AirLabs API anahtarı - app/queue/ingestion/airlabs_client.py
# tarafından okunur (bkz. _api_key()). BURADA ASLA gerçek değer
# YAZMAYIN.
AIRLABS_API_KEY=REPLACE_ME

# Veritabanı bağlantısı - app/db.py tarafından okunur. ZORUNLU: bu
# değer boş/REPLACE_ME bırakılırsa `app.db` import edilir edilmez
# (worker, web, HERHANGİ bir script - istisna yok) HİÇBİR SQLite
# fallback'i OLMADAN AÇIK bir RuntimeError ile başlangıç durur. Local
# geliştirme dahil - bu proje artık SQLite'ı hiçbir environment'ta
# örtük/otomatik olarak SEÇMEZ; local geliştiriciler de kendi MySQL
# instance'larına (ör. Docker) bağlanmalıdır.
#   MySQL   : mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4
#   Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=REPLACE_ME

# Opsiyonel - varsayılan "false" (bkz. app/queue/retention.py). Açıkça
# "true" yapılmadan hiçbir satır silinmez - production'da bilinçli
# bir karar olarak "true" yapılması ÖNERİLİR (bkz. deployment audit
# raporu - varsayılan kapalı kalırsa Flight/FlightEvent/QueuePrediction
# sınırsız büyür).
RETENTION_ENABLED=false

# Opsiyonel - varsayılan "true" (bkz. app/queue/retention.py). RETENTION_
# ENABLED=true YAPILDIKTAN SONRA, gerçek silme işlemini etkinleştirmek
# için bu AYRICA "false" yapılmalıdır - iki bağımsız güvenlik anahtarı.
RETENTION_DRY_RUN=true

# Opsiyonel - varsayılan INFO (bkz. app/logging_config.py). Geçersiz/
# boş bırakılırsa sessizce INFO'ya düşer.
LOG_LEVEL=INFO

# Opsiyonel - worker'ın tek-instance flock kilidinin yolu (bkz.
# app/worker.py:_acquire_worker_lock()). Varsayılan /run/airport-queue/
# worker.lock zaten airport-queue-worker.service'in RuntimeDirectory=
# ayarıyla yazılabilir - normalde DEĞİŞTİRMENİZ gerekmez.
# WORKER_LOCK_PATH=/run/airport-queue/worker.lock
