[Unit]
Description=Airport Queue Monitor - web server (read-only API + static frontend)
After=network.target

[Service]
Type=simple
User=airportqueue
Group=airportqueue
WorkingDirectory=/opt/airport-queue
Environment=PYTHONUNBUFFERED=1
# ADIM (MySQL Production Database) - airport-queue-worker.service ile
# AYNI dosya (bkz. deploy/systemd/aircraft-capacity.env.example) -
# APP_ENV=production ayarlıyken bu değer olmadan web server de SQLite'a
# SESSİZCE düşmez (bkz. app/db.py). Web server AIRLABS_API_KEY'i hiç
# okumaz ama aynı dosyayı paylaşmak (worker ile İKİ AYRI env dosyası
# yerine) config drift riskini ortadan kaldırır.
EnvironmentFile=/etc/aircraft-capacity/aircraft-capacity.env
ExecStart=/opt/airport-queue/venv/bin/python -m app.web.server --port 8000
Restart=always
RestartSec=5

# Web server SADECE DB'den okur (bkz. app/queue/api.py modül başlığı) -
# worker (airport-queue-worker.service) tamamen AYRI bir servistir;
# biri crash/restart olsa diğeri ETKİLENMEZ (iki ayrı systemd unit).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/airport-queue

[Install]
WantedBy=multi-user.target
